# Environment configuration for MOSAIC
# Copy this file to `.env` and adjust values for your local setup.
#
#   cp .env.example .env
#

# ==============================================================================
# Qt Configuration
# ==============================================================================
# IMPORTANT: Must be "PyQt6" (with capitals) for qasync to work correctly
QT_API=PyQt6

# Force X11/xcb platform plugin (avoids wayland fallback warnings on WSLg)
# Options: xcb (X11), wayland, offscreen (headless), minimal (no display)
# QT_QPA_PLATFORM=xcb

# Qt plugin debugging (set to 1 for debugging display issues)
QT_DEBUG_PLUGINS=0

# Disable QML disk cache
QML_DISABLE_DISK_CACHE=1

# ==============================================================================
# Gymnasium Defaults
# ==============================================================================
# GYM_DEFAULT_ENV=FrozenLake-v1
GYM_CONTROL_MODE=human_only
GYM_LOG_LEVEL=DEBUG

# ==============================================================================
# Generic Environment Defaults (0 uses Gym defaults)
# ==============================================================================
DEFAULT_RENDER_FPS=30

# ==============================================================================
# Box2D Environments
# ==============================================================================
# CarRacing
CAR_RACING_MAX_EPISODE_STEPS=0
CAR_RACING_MAX_EPISODE_SECONDS=0
CAR_RACING_LAP_COMPLETE_PERCENT=0.95
# Bipedal Walker
BIPEDAL_MAX_EPISODE_STEPS=0
BIPEDAL_MAX_EPISODE_SECONDS=0
BIPEDAL_HARDCORE=false

# ==============================================================================
# Toy Text Environments
# ==============================================================================
FROZEN_LAKE_IS_SLIPPERY=1

# ==============================================================================
# MuJoCo Environments
# ==============================================================================
MUJOCO_GL=egl
MUJOCO_FRAME_SKIP=5
MUJOCO_RENDER_FPS=67

# ==============================================================================
# Atari Environments
# ==============================================================================
ATARI_FRAMESKIP=4
ATARI_REPEAT_ACTION_PROBABILITY=0.0

# ==============================================================================
# MiniGrid Environments
# ==============================================================================
MINIGRID_AGENT_VIEW_SIZE=7
MINIGRID_HIGHLIGHT=1
MINIGRID_TILE_SIZE=32

# ==============================================================================
# ViZDoom Environments
# ==============================================================================
VIZDOOM_FRAME_SKIP=4
VIZDOOM_RENDER_WEAPON=1

# ==============================================================================
# MiniHack/NetHack Environments
# ==============================================================================
NETHACK_OBSERVATION_KEYS=glyphs,blstats,message

# ==============================================================================
# Crafter Environment
# ==============================================================================
CRAFTER_AREA_SIZE=256x256
CRAFTER_VIEW_SIZE=9x9
CRAFTER_MAX_EPISODE_STEPS=0

# ==============================================================================
# Procgen Environments
# ==============================================================================
PROCGEN_CENTER_AGENT=1

# ==============================================================================
# Platform Settings
# ==============================================================================
PLATFORM=ubuntu

# ==============================================================================
# gRPC Configuration
# ==============================================================================
# gRPC logging verbosity (ERROR, WARNING, INFO, DEBUG)
# Note: DEBUG triggers "Log level DEBUG is not suitable for production" warnings
GRPC_VERBOSITY=ERROR

# ==============================================================================
# SMAC / SMACv2 (StarCraft Multi-Agent Challenge) Environments
# ==============================================================================
# SC2PATH: Path to StarCraft II installation directory.
# Project-local headless Linux client lives at var/data/StarCraftII (not in git).
# Download the headless Linux client from Blizzard's s2client-proto releases and extract there.
# $PWD is the mosaic repo root when .env is sourced via run.sh.
SC2PATH=$PWD/var/data/StarCraftII

# Required: s2clientprotocol ships protobuf 3.x pb2 files; our gRPC/TF stack
# needs protobuf 5.x. Pure-Python implementation handles both.
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

SMAC_DIFFICULTY=7
SMAC_REWARD_SPARSE=false
SMAC_OBS_OWN_HEALTH=true
SMAC_OBS_PATHING_GRID=false
SMAC_OBS_TERRAIN_HEIGHT=false
SMAC_EPISODE_LIMIT=0

# ==============================================================================
# XuanCe / mpi4py Configuration
# ==============================================================================
# Prevent mpi4py from calling MPI_Init() at import time.
# XuanCe imports mpi4py at module level (statistic_tools.py); OpenMPI's
# MPI_Init() blocks forever when not launched via mpirun/mpiexec.
# Set to 0 to skip auto-init (recommended for GUI usage).
# Set to 1 only when launching with: mpirun -np <N> xuance-worker ...
MPI4PY_RC_INITIALIZE=0

# Disable tqdm progress bars globally.
# XuanCe's training loops (on_policy_marl.py) use tqdm to write a progress
# bar to stderr on every iteration (250k+ writes per phase). When the training
# process's stderr is piped to the telemetry proxy, the 1MB kernel pipe buffer
# fills up and the OS blocks the training process on write -- a pipe deadlock.
# Set to 1 to suppress all tqdm output (training progress is tracked via
# TensorBoard and FastLane instead). Must be set before tqdm is first imported.
TQDM_DISABLE=1

# ==============================================================================
# TensorFlow/Keras Configuration (for Melting Pot)
# ==============================================================================
# Suppress TensorFlow logging (0=all, 1=info, 2=warning, 3=error)
TF_CPP_MIN_LOG_LEVEL=2
# Disable oneDNN custom operations messages
TF_ENABLE_ONEDNN_OPTS=0

# ==============================================================================
# UI Settings
# ==============================================================================
# Start with Chat panel collapsed (true/false, default: true)
CHAT_PANEL_COLLAPSED=true

# ==============================================================================
# vLLM Server Configuration
# ==============================================================================
# Maximum number of vLLM server instances (1-8, default: 4)
VLLM_MAX_SERVERS=4

# GPU memory utilization per vLLM server (0.1-0.95, default: 0.85)
# 0.85 = 85% allocated to vLLM, leaving 15% for system and other tasks
VLLM_GPU_MEMORY_UTILIZATION=0.85

# vLLM base URL (for local inference)
VLLM_BASE_URL=http://localhost:8000/v1

# ==============================================================================
# LLM API Keys (OpenRouter)
# ==============================================================================
# OpenRouter provides unified access to all major LLM providers
# Models: openai/gpt-4o, anthropic/claude-3-5-sonnet, meta-llama/llama-3.2-90b-vision-instruct
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_api_key_here

# HuggingFace Token (required for gated models like Llama)
# Get your token from: https://huggingface.co/settings/tokens
# Accept model license at: https://huggingface.co/meta-llama
HF_TOKEN=hf_your_token_here

# ==============================================================================
# Weights & Biases (wandb) Configuration
# ==============================================================================
# Get your API key from: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# WANDB Project Name
WANDB_PROJECT_NAME=MOSAIC

# WANDB Entity Name (your wandb username)
WANDB_ENTITY_NAME=your_wandb_username

# WANDB email
WANDB_EMAIL=your_email@example.com

# WANDB VPN PROXY (uncomment if needed)
# WANDB_VPN_HTTPS_PROXY=https://127.0.0.1:7890
# WANDB_VPN_HTTP_PROXY=http://127.0.0.1:7890

# WANDB Monitor Gym (0=disabled, 1=enabled)
WANDB_MONITOR_GYM=0

# ==============================================================================
# Python Warnings
# ==============================================================================
PYTHONWARNINGS=ignore::UserWarning:pkg_resources

# ==============================================================================
# Codecov
# ==============================================================================
# Upload token for coverage reports (used in CI)
# CODECOV_TOKEN=your_codecov_token_here

# ==============================================================================
# Google Research Football (GRF) Rendering
# ==============================================================================
# Path to the GRF game-engine data directory (BMPs, textures, menus, models).
# MUST point to the vendored gfootball_engine/data dir, or the C++ engine
# will SIGSEGV on scene load (LoadingMatchPage → IMG_LoadBmp null-deref).
# Do NOT point to var/data/gfootball — that only holds boost libs and npy
# verification files, no game assets. Resolves via $PWD because run.sh
# cd's to the project root before sourcing this file.
GFOOTBALL_DATA_DIR="$PWD/3rd_party/environments/football/third_party/gfootball_engine/data"

# The GRF C++ engine always creates its own top-level SDL window. When GRF runs
# inside MOSAIC its frames are shown in the Render View, so that extra window is
# a second, redundant window on screen.
#
# Setting this to 1 makes the engine create the window with SDL_WINDOW_HIDDEN:
# the OpenGL context still exists (so rgb_array frames are produced exactly as
# before) but the window is never mapped. Set to 0 to restore the upstream
# behaviour and show the engine's own window.
#
# Requires the MOSAIC patch in
# 3rd_party/environments/football/third_party/gfootball_engine/
#   src/systems/graphics/rendering/opengl_renderer3d.cpp
# Default: 1
GFOOTBALL_HIDDEN_WINDOW=1

# ==============================================================================
# RWARE (Robotic Warehouse) Rendering
# ==============================================================================
# RWARE's rware.rendering.Viewer unconditionally creates a pyglet.window.Window()
# with no visible argument, which pops a real OS window even in rgb_array mode.
# MOSAIC renders RWARE frames inside its own Render View, so that extra window
# is a second, redundant window on screen.
#
# Setting this to 1 patches pyglet.window.Window.__init__ to default
# visible=False before RWARE ever creates a window: the OpenGL context still
# exists (so rgb_array frames are produced exactly as before) but the window
# is never shown. Set to 0 to restore the upstream behaviour and show the
# engine's own window.
# Default: 1
RWARE_HIDDEN_WINDOW=1
